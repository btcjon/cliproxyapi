# Sanitized — placeholders only (REPLACE_ME). Do not commit live keys.
# Server Settings
port: 8317
auth-dir: "~/.cli-proxy-api"
remote-management:
  allow-remote: true
  secret-key: REPLACE_ME  disable-control-panel: false
debug: false
logging-to-file: true
proxy-url: ""
# Request Handling
request-retry: 3
routing:
  strategy: "fill-first"
quota-exceeded:
  switch-project: false
  switch-preview-model: false
# Usage Tracking
usage-statistics-enabled: true

# Z.AI GLM lane via Anthropic-compatible endpoint.
claude-api-key:
  - api-key: REPLACE_ME    prefix: "zai"
    base-url: "https://api.z.ai/api/anthropic"
    headers:
      anthropic-version: "2023-06-01"
    models:
      - name: "glm-5"
        alias: "glm-5"
      - name: "glm-5-turbo"
        alias: "glm-5-turbo"
      - name: "glm-5.1"
        alias: "glm-5.1"
      - name: "glm-5v-turbo"
        alias: "glm-5v-turbo"

# OpenAI-Compatible Providers
openai-compatibility:
  # Z.AI GLM vision / general OpenAI-compatible API (includes glm-5v-turbo)
  - name: "zai-vision"
    base-url: "https://api.z.ai/api/paas/v4"
    api-key-entries:
      - api-key: REPLACE_ME    models:
      - name: "glm-5v-turbo"
        alias: "glm-5v-turbo"
  # Baseten Kimi 2 Thinking
  # Advanced reasoning model from Moonshot AI
  - name: "baseten"
    base-url: "https://inference.baseten.co/v1"
    api-key-entries:
      - api-key: REPLACE_ME    models:
      - name: "moonshotai/Kimi-K2-Thinking"
        alias: "kimi-k2-thinking"
  # Venice AI via OpenAI-compatible API
  - name: "venice"
    prefix: "venice"
    base-url: "https://api.venice.ai/api/v1"
    api-key-entries:
      - api-key: REPLACE_ME    models:
      - name: "venice-uncensored"
        alias: "venice-uncensored"

oauth-excluded-models:
  gemini-cli:
    - "gemini-2.5-flash"
    # PKG2 Flash kill — do not restore OAuth Flash exposure
    - "gemini-2.5-flash-lite"
    - "gemini-3-flash"
    - "gemini-3-flash-preview"
    - "gemini-3.1-flash-lite"
    - "gemini-3.1-flash-lite-preview"
  claude:
    # Retain only the latest useful generation in the public catalog.
    - "claude-opus-4-1-20250805"
    - "claude-opus-4-20250514"
    - "claude-opus-4-5-20251101"
    - "claude-opus-4-6"
    - "claude-opus-4-6-thinking"
    - "claude-opus-4-7"
    - "claude-opus-4-8"
    - "claude-sonnet-4-20250514"
    - "claude-sonnet-4-5-20250929"
    - "claude-sonnet-4-6"
    - "claude-3-7-sonnet-20250219"
    - "claude-3-5-haiku-20241022"
  antigravity:
    - "claude-opus-4-6-thinking"
    - "claude-sonnet-4-6"
  codex:
    - "gpt-5"
    - "gpt-5.1"
    - "gpt-5.1-codex"
    - "gpt-5.1-codex-max"
    - "gpt-5.1-codex-mini"
    - "gpt-5-codex"
    - "gpt-5-codex-mini"

oauth-model-alias:
  claude:
    - name: "claude-sonnet-5"
      alias: "sonnet"
      fork: true
    - name: "claude-opus-5"
      alias: "opus"
      fork: true
    - name: "claude-haiku-4-5-20251001"
      alias: "haiku"
      fork: true
  gemini-cli:
    - name: "gemini-3.1-pro-preview"
      alias: "gpro"
      fork: true
    # PKG2 REMOVED gflash <- gemini-3-flash-preview (OAuth Flash kill; do not restore)

